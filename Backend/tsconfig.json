{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "scr",
    "outDir": "dist"
  },
  "include": ["scr/**/*.ts"],
  "exclude": ["scr/servers/**", "node_modules", "dist"]
}
